{
  "name": "ruleswright",
  "version": "0.1.0",
  "description": "Headless TypeScript library: one-line theme → complete, playable d20-style campaign pack, consumed by an embeddable party/character/combat runtime.",
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "require": "./dist/runtime.cjs",
      "default": "./dist/runtime.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "require": "./dist/schema.cjs",
      "default": "./dist/schema.js"
    },
    "./compiler": {
      "types": "./dist/compiler.d.ts",
      "require": "./dist/compiler.cjs",
      "default": "./dist/compiler.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "test": "vitest run",
    "build": "tsup",
    "check:isolation": "node scripts/check-runtime-isolation.mjs",
    "check:security": "node scripts/check-security-lint.mjs",
    "verify:package": "pnpm build && pnpm check:isolation && pnpm check:security"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "eslint": "^8.57.1",
    "prettier": "^3.3.3",
    "tsup": "^8.3.0",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
}