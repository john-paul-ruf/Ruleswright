{
  "name": "ruleswright",
  "version": "0.1.0",
  "description": "Headless TypeScript library: one-line theme → complete, playable d20-style campaign pack, consumed by an embeddable party/character/combat runtime.",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.15.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/john-paul-ruf/d20-rpg-system.git"
  },
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "require": "./dist/runtime.cjs",
      "default": "./dist/runtime.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "require": "./dist/schema.cjs",
      "default": "./dist/schema.js"
    },
    "./compiler": {
      "types": "./dist/compiler.d.ts",
      "require": "./dist/compiler.cjs",
      "default": "./dist/compiler.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "build": "tsup",
    "check:isolation": "node scripts/check-runtime-isolation.mjs",
    "check:security": "node scripts/check-security-lint.mjs",
    "verify:package": "pnpm build && pnpm check:isolation && pnpm check:security"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.3.3",
    "tsup": "^8.3.0",
    "typescript": "5.6.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "2.1.8"
  }
}
