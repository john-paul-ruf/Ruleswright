{
  "name": "ruleswright",
  "version": "0.1.0",
  "description": "Headless TypeScript library: one-line theme → complete, playable d20-style campaign pack, consumed by an embeddable party/character/combat runtime.",
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "test": "vitest run",
    "build": "tsup"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "eslint": "^8.57.1",
    "prettier": "^3.3.3",
    "tsup": "^8.3.0",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
}