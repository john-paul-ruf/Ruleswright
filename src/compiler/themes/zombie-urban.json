{
  "id": "zombie-urban",
  "title": "The Quarantine Mile",
  "readme": "Zombie-urban drain-pool & table showcase (FR-21). Deliberately omits the optional economy section: the engine's documented default grants 1 of each slot name seen in action costs (main, move, reaction) — S05's both-branches proof from the pack side. Knobs: threat (wandering table weight), infectionRate (district loot/infection table weighting 1-5, default 2), scavenging (supplies table density 1-5, default 3), adrenalineMode (drain-pool flavor: adrenaline vs stamina naming). Example override (FR-19): { \"overrides\": [ { \"target\": \"grave-shambler\", \"patch\": { \"threat\": 2 } } ] } — same-seed regeneration reproduces the pack, so the edit anchors.",
  "knobs": {
    "threat": {
      "type": "enum",
      "values": ["low", "medium", "high"],
      "default": "medium",
      "desc": "Wandering-threat weight: low thins the district, high stacks the hordes."
    },
    "infection-rate": {
      "type": "range",
      "min": 1,
      "max": 5,
      "default": 2,
      "desc": "Infection-table weighting: how often bites turn."
    },
    "scavenging": {
      "type": "range",
      "min": 1,
      "max": 5,
      "default": 3,
      "desc": "Supplies-table density: how much the blocks still yield."
    },
    "adrenaline-mode": {
      "type": "enum",
      "values": ["adrenaline", "stamina"],
      "default": "adrenaline",
      "desc": "The survivor pool's flavor name (same engine, drain both ways)."
    }
  },
