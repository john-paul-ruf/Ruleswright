{
  "id": "wyldwood",
  "title": "The Wyldwood Verge",
  "readme": "Wyldwood fey/wilderness showcase (FR-21): the format's third proof, a charm/ward loot economy with hedge-magic spell lists and no vancian slots — spells ride point pools (motes) only. Knobs: threat (bestiary budget weight), briarDensity (briar-band table weighting 1-5, default 2), hedgeMagic (hedge-mage list size 1-5, default 3), wardDepth (ward-table depth: light = flatter loot, deep = the full chain). Example override (FR-19): { \"overrides\": [ { \"target\": \"thorn-wolf\", \"patch\": { \"threat\": 2 } } ] } — patches the wolf's budget weight; same-seed regeneration reproduces the pack, so the edit anchors.",
  "knobs": {
    "threat": {
      "type": "enum",
      "values": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium",
      "desc": "Bestiary threat budget: low thins the briar paths, high stacks the glades."
    },
    "briar-density": {
      "type": "range",
      "min": 1,
      "max": 5,
      "default": 2,
      "desc": "Briar-band table weighting: how thick the thorns run between clearings."
    },
    "hedge-magic": {
      "type": "range",
      "min": 1,
      "max": 5,
      "default": 3,
      "desc": "Hedge-mage list size: how many charms the lists carry."
    },
    "ward-depth": {
      "type": "enum",
      "values": [
        "light",
        "deep"
      ],
      "default": "deep",
      "desc": "Ward-table depth: light keeps the hedge-ward table shallow, deep stacks the chain."
    },
    "mote-base": {
      "type": "range",
      "min": 2,
      "max": 12,
      "default": 6,
      "desc": "Base mote capacity before the insight term (the pool formula’s knob)."
    }
  },
