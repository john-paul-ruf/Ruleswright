{
  "id": "dark-fantasy",
  "title": "The Barrowland Crown",
  "readme": "Dark-fantasy vancian showcase (FR-21). Knobs: threat (bestiary budget weight), spellDensity (coined spells per level, 1-5, default 3), grittiness (heroic doubles HD floors, mortal keeps them), demihumanCaps (on = classic level-cap curve, off = uncapped). Example override (FR-19): { \"overrides\": [ { \"target\": \"barrow-wight\", \"patch\": { \"saveOverrides\": { \"reason\": 5 } } } ] } — patches the wight's reason save; same-seed regeneration reproduces the pack, so the edit anchors.",
  "knobs": {
    "threat": { "type": "enum", "values": ["low", "medium", "high"], "default": "medium", "desc": "Bestiary threat budget: low thins the wandering table, high stacks the deep barrows." },
    "spell-density": { "type": "range", "min": 1, "max": 5, "default": 3, "desc": "Coined spells per level band, L1-3." },
    "grittiness": { "type": "enum", "values": ["heroic", "mortal"], "default": "heroic", "desc": "HP and damage scaling: heroic raises HD, mortal keeps the classic curve." },
    "demihuman-caps": { "type": "enum", "values": ["on", "off"], "default": "on", "desc": "Classic demihuman level caps: on = cap curve, off = uncapped demihumans." }
  },
  "stats": {
