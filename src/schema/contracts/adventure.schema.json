{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ruleswright.dev/schemas/1/adventure.schema.json",
  "title": "Ruleswright Adventure Template and Definition \u2014 schemaVersion 1",
  "oneOf": [
    {
      "$ref": "#/$defs/template"
    },
    {
      "$ref": "#/$defs/definition"
    }
  ],
  "$defs": {
    "templateIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "definitionIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "schemaVersion", "contentHash"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "schemaVersion": {
          "const": 1
        },
        "contentHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}$"
        }
      }
    },
    "reward": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "xpPerMember", "eligible", "loot"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "xpPerMember": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "eligible": {
          "const": "party"
        },
        "loot": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["tableId", "recipient"],
              "properties": {
                "tableId": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*$"
                },
                "recipient": {
                  "const": "host-choice"
                }
              }
            }
          ]
        }
      },
      "description": "Authored reward authority; per-member XP, not shared pot/class XP. Party membership fixed at adventure start. Zero XP is supported by skipping awardXp(0). Loot requires explicit host-chosen eligible member even if staged result grants no item. Table id resolves in pack.tables; never infer XP from threat."
    },
    "facts": {
      "type": "object",
      "additionalProperties": {
        "type": ["string", "number", "boolean", "null"]
      },
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      }
    },
    "directorPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "priorities",
        "targetOrder",
        "tieBreak",
        "reactionPriority",
        "maxCandidates",
        "stallLimit"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "priorities": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "actionId"],
                "properties": {
                  "kind": {
                    "enum": ["action", "move"]
                  },
                  "actionId": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]*$"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind"],
                "properties": {
                  "kind": {
                    "const": "pass"
                  }
                }
              }
            ]
          },
          "minItems": 1
        },
        "targetOrder": {
          "enum": ["id", "nearest", "lowest-hp"]
        },
        "tieBreak": {
          "enum": ["lexical", "seeded"]
        },
        "reactionPriority": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "uniqueItems": true
        },
        "maxCandidates": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "stallLimit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "description": "Ordered authored legal-action/move priorities with final pass; refs resolve to pack actions, move is a root move action. Reactions use held real offers (legal take else decline), order by reactionPriority then ids. Player offers never automated. MaxCandidates bounds enumeration; stallLimit bounds consecutive unchanged mechanical states. nearest requires spatial layout."
    },
    "narration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fragments"],
      "properties": {
        "fragments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "eventType", "text", "slots"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "eventType": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string"
              },
              "slots": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name", "path"],
                  "properties": {
                    "name": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]*$"
                    },
                    "path": {
                      "type": "string",
                      "pattern": "^(type|actor|target|why\\.rule|why\\.rolls|payload\\.[A-Za-z][A-Za-z0-9-]*|facts\\.[a-z][a-z0-9-]*)$"
                    }
                  }
                },
                "uniqueItems": true
              }
            }
          }
        }
      },
      "description": "One fragment per event type; {slot-name} placeholders must match unique declared slots. Facts paths resolve in declared definition/node facts; event paths must be declared for that event, or use factual fallback if absent. Interpolation is literal text, never code/HTML or mechanics. Empty fragments is valid: generic factual event rendering."
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "title", "description", "rewardIds", "rest", "preparation", "facts"],
      "properties": {
        "kind": {
          "enum": ["discovery", "encounter", "rest"]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "encounter": {
          "$ref": "play-session.schema.json#/$defs/encounterSetup"
        },
        "rewardIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "uniqueItems": true
        },
        "rest": {
          "enum": ["none", "once"]
        },
        "preparation": {
          "type": "boolean"
        },
        "facts": {
          "$ref": "#/$defs/facts"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "encounter"
              }
            }
          },
          "then": {
            "required": ["encounter"]
          },
          "else": {
            "not": {
              "required": ["encounter"]
            }
          }
        }
      ]
    },
    "descriptorTable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "entries"],
      "properties": {
        "kind": {
          "const": "weighted"
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["weight", "value"],
            "properties": {
              "weight": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4294967296
              },
              "value": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              }
            }
          },
          "minItems": 1
        }
      },
      "description": "Existing core rollTable weighted shape. value names a location descriptor, never executable prose. Sum of weights <= 2^32, checked semantically."
    },
    "nodeRecipe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "tableId"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "tableId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        }
      }
    },
    "branch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "fromNodeId", "toNodeId", "nodes", "includeWeight", "omitWeight", "choiceTextRef"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "fromNodeId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "toNodeId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nodeRecipe"
          },
          "minItems": 1
        },
        "includeWeight": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967296
        },
        "omitWeight": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967296
        },
        "choiceTextRef": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        }
      },
      "description": "Bounded optional detour between ordered spine anchors. Roll a two-entry core weighted table; omitWeight=0 means include without a draw. New branches never strand nodes or bypass a terminal predicate. include+omit <= 2^32."
    },
    "construction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry", "spine", "terminal", "branches", "continueTextRef"],
      "properties": {
        "entry": {
          "$ref": "#/$defs/nodeRecipe"
        },
        "spine": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nodeRecipe"
          },
          "minItems": 1
        },
        "terminal": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "title", "description"],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string"
            }
          }
        },
        "branches": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/branch"
          }
        },
        "continueTextRef": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        }
      },
      "description": "Finite DAG: entry -> spine in array order -> success terminal. Included branches add a second route from an earlier spine/entry anchor to a later spine/terminal anchor. Internal branch edges use continueTextRef; entry edge uses choiceTextRef. No cycles, retries or prose interpretation."
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "schemaVersion",
        "id",
        "version",
        "pack",
        "nodeBounds",
        "objective",
        "tables",
        "locations",
        "fragments",
        "construction",
        "rewards",
        "facts",
        "director",
        "narration"
      ],
      "properties": {
        "kind": {
          "const": "adventure-template"
        },
        "schemaVersion": {
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "pack": {
          "$ref": "snapshots.schema.json#/$defs/packIdentity"
        },
        "nodeBounds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "max"],
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 3,
              "maximum": 9007199254740991
            },
            "max": {
              "type": "integer",
              "minimum": 3,
              "maximum": 9007199254740991
            }
          }
        },
        "objective": {
          "$ref": "#/$defs/objective"
        },
        "tables": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/descriptorTable"
          },
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        },
        "locations": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/location"
          },
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        },
        "fragments": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        },
        "construction": {
          "$ref": "#/$defs/construction"
        },
        "rewards": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reward"
          }
        },
        "facts": {
          "$ref": "#/$defs/facts"
        },
        "director": {
          "$ref": "#/$defs/directorPolicy"
        },
        "narration": {
          "$ref": "#/$defs/narration"
        }
      },
      "description": "AR-03 separate bound template, not ThemeTemplate or a Pack field. pack is the effective merged pack identity. The bundled loader explicitly accepts pack and binds a copied recipe (template fields except pack); generateAdventure rejects foreign bound identities. Preflight verifies min/max against all possible branches, all refs, weights, capacity and policies."
    },
    "choice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "toNodeId"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "toNodeId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "title",
        "description",
        "choices",
        "rewardIds",
        "rest",
        "preparation",
        "facts"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "kind": {
          "enum": ["discovery", "encounter", "rest", "success"]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "choices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/choice"
          }
        },
        "encounter": {
          "$ref": "play-session.schema.json#/$defs/encounterSetup"
        },
        "rewardIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "uniqueItems": true
        },
        "rest": {
          "enum": ["none", "once"]
        },
        "preparation": {
          "type": "boolean"
        },
        "facts": {
          "$ref": "#/$defs/facts"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "encounter"
              }
            }
          },
          "then": {
            "required": ["encounter"]
          },
          "else": {
            "not": {
              "required": ["encounter"]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "success"
              }
            }
          },
          "then": {
            "properties": {
              "choices": {
                "maxItems": 0
              },
              "rest": {
                "const": "none"
              },
              "preparation": {
                "const": false
              }
            }
          }
        }
      ]
    },
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "schemaVersion",
        "id",
        "template",
        "pack",
        "seed",
        "objective",
        "startNodeId",
        "successNodeId",
        "nodes",
        "rewards",
        "facts",
        "director",
        "narration",
        "contentHash"
      ],
      "properties": {
        "kind": {
          "const": "adventure-definition"
        },
        "schemaVersion": {
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "template": {
          "$ref": "#/$defs/templateIdentity"
        },
        "pack": {
          "$ref": "snapshots.schema.json#/$defs/packIdentity"
        },
        "seed": {
          "type": "string"
        },
        "objective": {
          "$ref": "#/$defs/objective"
        },
        "startNodeId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "successNodeId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          },
          "minItems": 3
        },
        "rewards": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reward"
          }
        },
        "facts": {
          "$ref": "#/$defs/facts"
        },
        "director": {
          "$ref": "#/$defs/directorPolicy"
        },
        "narration": {
          "$ref": "#/$defs/narration"
        },
        "contentHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}$"
        }
      },
      "description": "Resolved finite DAG, exact encounter setups/rewards/policies and narrative text. contentHash = existing packContentHash over the entire definition excluding only contentHash. id is template.id; seed canonical String(seed). No callbacks/runtime objects. Unique node/reward ids and choice ids within each node, reachable nodes and success, all references and pack identity checked before exposure."
    },
    "adventureStartOptions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adventureId", "seed", "members"],
      "properties": {
        "adventureId": {
          "type": "string",
          "minLength": 1
        },
        "seed": {
          "$ref": "play-session.schema.json#/$defs/seed"
        },
        "members": {
          "$ref": "play-session.schema.json#/$defs/members"
        }
      }
    }
  }
}
