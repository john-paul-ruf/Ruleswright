{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ruleswright.dev/schemas/1/snapshots.schema.json",
  "title": "Ruleswright Snapshot Envelopes — snapshotVersion 1",
  "description": "Three serializers (FR-14): character, party, combat. State only — no timestamps, no captured environment. Every envelope carries pack identity; combat pairs with a party snapshot. Load discipline: identity check first; mismatch = loud refusal E-SNAP-01; stale version = E-SNAP-02. No v1 migration.",
  "type": "object",
  "oneOf": [
    { "$ref": "#/$defs/characterSnapshot" },
    { "$ref": "#/$defs/partySnapshot" },
    { "$ref": "#/$defs/combatSnapshot" }
  ],

  "$defs": {
    "packIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "schemaVersion", "contentHash"],
      "properties": {
        "id": { "type": "string" },
        "schemaVersion": { "type": "integer", "minimum": 1 },
        "contentHash": {
          "type": "string",
          "minLength": 8,
          "description": "Pack content hash; mismatch on load = E-SNAP-01 (FR-14)"
        }
      }
    },

    "rngState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["a", "b", "c", "d"],
      "properties": {
        "a": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "b": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "c": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "d": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
      },
      "description": "Four uint32 sfc32 words (FR-1). Resume test: next roll equals the uninterrupted fight's next roll."
    },

    "characterState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "race", "classes", "abilities", "conditions", "inventory"],
      "properties": {
        "name": { "type": "string" },
        "race": { "type": "string" },
        "classes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "level"],
            "properties": {
              "id": { "type": "string" },
              "level": { "type": "integer", "minimum": 1, "maximum": 10 },
              "xp": {
                "type": "integer",
                "minimum": 0,
                "description": "XP accumulates per class per pack split policy (FR-6)"
              }
            }
          }
        },
        "abilities": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "integer" },
          "description": "Name-keyed (FR-5)"
        },
        "skills": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "feats": { "type": "array", "items": { "type": "string" } },
        "knownSpells": { "type": "array", "items": { "type": "string" } },
        "pools": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 },
          "description": "poolId -> current points (FR-8)"
        },
        "slots": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": ["null", "string"],
              "description": "Binding: null = empty slot, string = memorized spell id (FR-8)"
            }
          }
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "remaining"],
            "properties": { "id": { "type": "string" }, "remaining": { "type": "integer", "minimum": 0 } }
          }
        },
        "inventory": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "qty"],
            "properties": { "id": { "type": "string" }, "qty": { "type": "integer", "minimum": 1 } }
          }
        },
        "equipped": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["slot", "itemId"],
            "properties": {
              "slot": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$",
                "description": "A slot id declared in the pack's equipSlots"
              },
              "itemId": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$",
                "description": "A content.items id whose slots list admits this slot"
              }
            }
          },
          "description": "v1.4 — optional equipment state: one {slot, itemId} entry per occupied slot (one item per slot). Absent = nothing equipped (equivalent to []). The runtime emits the key only when the character's state carries it, preserving the byte-exact round-trip of characters that never equipped. Slot uniqueness across entries cannot be expressed in JSON Schema (uniqueItems compares whole objects), so runtime restore enforces it fail-closed, together with item/slot existence, slot eligibility and held quantity — any violation = E-SNAP-01, all refusals collected before any application. Inventory still restores verbatim."
        }
      }
    },

    "characterSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "snapshotVersion", "pack", "state"],
      "properties": {
        "kind": { "const": "character" },
        "snapshotVersion": { "const": 1 },
        "pack": { "$ref": "#/$defs/packIdentity" },
        "state": { "$ref": "#/$defs/characterState" }
      }
    },

    "partySnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "snapshotVersion", "pack", "members"],
      "properties": {
        "kind": { "const": "party" },
        "snapshotVersion": { "const": 1 },
        "pack": { "$ref": "#/$defs/packIdentity" },
        "members": { "type": "array", "items": { "$ref": "#/$defs/characterState" } }
      }
    },

    "combatSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "snapshotVersion",
        "pack",
        "pairsWith",
        "round",
        "turn",
        "order",
        "rng",
        "combatants"
      ],
      "properties": {
        "kind": { "const": "combat" },
        "snapshotVersion": { "const": 1 },
        "pack": { "$ref": "#/$defs/packIdentity" },
        "pairsWith": {
          "type": "string",
          "description": "Party snapshot id — the documented pairing (FR-14)"
        },
        "round": { "type": "integer", "minimum": 1 },
        "turn": { "type": "integer", "minimum": 0 },
        "order": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "rng": { "$ref": "#/$defs/rngState" },
        "combatants": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "hp"],
            "properties": {
              "id": { "type": "string" },
              "hp": { "type": "integer", "minimum": 0 },
              "slotsUsed": {
                "type": "object",
                "additionalProperties": { "type": "integer", "minimum": 0 },
                "description": "Per-turn transient: generic slot economy state (FR-4)"
              },
              "conditions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "remaining"],
                  "properties": {
                    "id": { "type": "string" },
                    "remaining": { "type": "integer", "minimum": 0 }
                  }
                }
              },
              "position": {
                "type": ["null", "object"],
                "description": "Present only when the pack declares a spatial model (FR-11)"
              },
              "pendingTrigger": {
                "type": ["null", "string"],
                "description": "Reactive action currently offered (FR-4/13)"
              },
              "itemsUsed": {
                "type": "object",
                "propertyNames": { "pattern": "^[a-z][a-z0-9-]*$" },
                "additionalProperties": { "type": "integer", "minimum": 0 },
                "description": "v1.4 — optional: item id -> units this combatant has SPENT in this fight (not units remaining). Deliberately unlike slotsUsed, which serializes the remaining per-turn ledger: fight-start item balances are not in the snapshot — restore takes them from the host's re-stated CombatRestoreRequest balances (balances.items), the same way pools and boundSlots are re-stated, and this snapshot value wins for the spend. Remaining = restated balance - itemsUsed. An unknown item id or a spend exceeding the restated balance = E-SNAP-01. Absent = nothing spent."
              },
              "maxHp": {
                "type": "integer",
                "minimum": 0,
                "description": "v1.4 — optional: the combatant's heal cap, fixed at fight start (characters: derived hp with equipment grants; statblocks: the hp formula value). A heal never raises hp above maxHp and never lowers hp: a combatant already above its cap stays unchanged. Restore precedence: this snapshot value wins over the re-stated profile; when absent (a pre-v1.4 envelope) restore falls back to the profile's maxHp, then to the profile's hp (floored at 0)."
              },
              "pendingMove": {
                "type": "object",
                "additionalProperties": false,
                "required": ["actionId", "to", "remaining"],
                "properties": {
                  "actionId": { "type": "string" },
                  "to": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["x", "y"],
                    "properties": { "x": { "type": "integer" }, "y": { "type": "integer" } }
                  },
                  "remaining": { "type": "integer", "minimum": 0 }
                },
                "description": "v1.5 — optional: a move paused by open leaving-reach offers (FR-11). Resumes when the offer queue empties. Unknown or non-move actionId = E-SNAP-01. Absent = no paused move. Restore derives the resolved phase when any combatant carries pendingMove or pendingTrigger (no envelope field)."
              }
            }
          }
        }
      }
    }
  }
}
